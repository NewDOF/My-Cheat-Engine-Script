    <CheatEntry>
      <ID>2086</ID>
      <Description>""Mono" Launcher"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[enable]

{$lua}
LaunchMonoDataCollector()

{$asm}
globalalloc(EXPValue, 4)
globalalloc(ItemAddress, 4)
globalalloc(StatusAddress, 4)
globalalloc(TreasuryValue, 4)

EXPValue:
dd (int)9999

ItemAddress:
dd 0

StatusAddress:
dd 0

TreasuryValue:
dd (int)9999999

[disable]
</AssemblerScript>
